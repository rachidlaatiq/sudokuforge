# Paddle Billing Settings (Client-Side & SDK)
VITE_PADDLE_CLIENT_TOKEN=YOUR_PADDLE_CLIENT_TOKEN
VITE_PADDLE_ENVIRONMENT=sandbox
VITE_PADDLE_MONTHLY_PRICE_ID=YOUR_PADDLE_MONTHLY_PRICE_ID
VITE_PADDLE_LIFETIME_PRICE_ID=YOUR_PADDLE_LIFETIME_PRICE_ID

# Paddle API Configuration (Server-Side SDK)
PADDLE_API_KEY=YOUR_PADDLE_API_KEY
PADDLE_WEBHOOK_SECRET=YOUR_PADDLE_WEBHOOK_SECRET
PADDLE_ENVIRONMENT=sandbox

# JWT Authentication Config
JWT_SECRET=YOUR_JWT_SECRET_KEY

# Backend Server Port
PORT=3001
